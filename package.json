{
  "name": "mini-gcs",
  "version": "0.1.0",
  "description": "Mini ground control station: Electron + React + MAVLink telemetry, map, trajectory prediction",
  "main": "./out/main/index.js",
  "author": "Oleksandr Uvarov",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fake": "tsx --tsconfig tsconfig.node.json tools/fake-source.ts",
    "smoke": "tsx --tsconfig tsconfig.node.json tools/smoke-receive.ts",
    "record": "tsx --tsconfig tsconfig.node.json tools/record-tlog.ts",
    "sitl": "sh tools/sitl/run.sh",
    "sitl:build": "docker build -t mini-gcs-sitl tools/sitl",
    "sitl:fly": "docker exec -i mini-gcs-sitl python3 - < tools/sitl/fly.py",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "maplibre-gl": "^6.12.0",
    "node-mavlink": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
